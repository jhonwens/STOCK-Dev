{
  "$schema": "https://raw.githubusercontent.com/nickl/tauri/packages/api/schema.json",
  "productName": "衡势价值",
  "version": "0.1.0",
  "identifier": "com.hengshi-value.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "衡势价值",
      "width": 1280,
      "height": 800,
      "minWidth": 1024,
      "minHeight": 600
    }]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend/pyentry/": "backend/pyentry/",
      "../backend/stock-analyst/scripts/": "backend/stock-analyst/scripts/",
      "../backend/stock-analyst/resource/": "backend/stock-analyst/resource/",
      "../backend/stock-analyst/data/": "backend/stock-analyst/data/"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}